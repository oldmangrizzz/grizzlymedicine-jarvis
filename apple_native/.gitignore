# ─── CMake build trees ────────────────────────────────────────────────────────
# Never commit generated CMake/FetchContent artifacts. All build directories
# under JARVISNativeRuntime/ are regenerable from source.

# Top-level build directories
JARVISNativeRuntime/build/
JARVISNativeRuntime/build_*/
JARVISNativeRuntime/*/build/
JARVISNativeRuntime/*/build_*/
JARVISNativeRuntime/*/*/build/
JARVISNativeRuntime/*/*/build_*/
JARVISNativeRuntime/*/*/*/build/
JARVISNativeRuntime/*/*/*/build_*/

# Specific named build trees
JARVISNativeRuntime/build_props/
JARVISNativeRuntime/build_fuzz/
JARVISNativeRuntime/build_regression/
JARVISNativeRuntime/build_side_channel_memory_check/
JARVISNativeRuntime/build_identity_spoof_memory_check/
JARVISNativeRuntime/build_character_values/
JARVISNativeRuntime/build_memory_extraction/

# CMake generated files (anywhere in the tree)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_CPack_Packages/

# FetchContent download cache and extracted deps
**/_deps/

# ─── Compiled dylibs / binaries ───────────────────────────────────────────────
# These are either downloaded (onnxruntime) or built (SE dylib).
# Never commit prebuilt binaries — record URL+SHA256 in CMakeLists.txt instead.
*.dylib
*.dSYM/
*.a
*.o
*.so

# ─── SwiftPM build outputs ───────────────────────────────────────────────────
# The root .gitignore already covers .build/ but be explicit here too.
.build/
.swiftpm/
DerivedData/

# ─── Xcode local state ────────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/

# ─── Voice / TTS model artifacts (regenerable; §3 voice math) ─────────────────
# Generated by JARVISNativeRuntime/voice/tts/coreml/tools/run_conversion.py.
# Baseline SHAs tracked in chkpts + sbom/voice-weights-baseline.json, not git blob.
# voice_state.bin §3 baseline lives with operator, not in repo.
**/voice/tts/coreml/models/*.mlpackage/
**/voice/tts/coreml/models/voice_state.bin
**/voice/tts/coreml/models/voice_state.json
**/voice/tts/coreml/models/voice_state_check.npy
**/voice/tts/coreml/models/tokenizer.model
**/voice/tts/coreml/conversion_logs/

# Alternate audio tree (operator-deferred duplicate).
**/audio/tts_coreml/models/*.mlpackage/
**/audio/tts_coreml/conversion_logs/

# Blanket: CoreML packages are large model artifacts, never commit anywhere.
*.mlpackage/

# Other voice model formats (torch / onnx) — also regenerable, large.
**/audio/tts_libtorch/models/*.pt
**/audio/tts_libtorch/models/*.bin
**/audio/tts_onnx/onnx_models/*.onnx
**/voice/tts/libtorch/models/*.pt
**/voice/tts/libtorch/models/*.bin
**/voice/tts/onnx/onnx_models/*.onnx

# Alternate audio tree voice baseline + tokenizer (same artifacts, different path).
**/audio/tts_coreml/models/voice_state.bin
**/audio/tts_coreml/models/voice_state.json
**/audio/tts_coreml/models/voice_state_check.npy
**/audio/tts_coreml/models/tokenizer.model

# ─── CMake / build dirs anywhere ─────────────────────────────────────────────
# CMake build trees beyond the explicit JARVISNativeRuntime/ list above.
**/build/
**/build-asan*/
**/build-tsan*/
**/build_*/

# Runtime-emitted audit logs (operator-controlled artifacts).
**/integrity/audit/*.audit.log
