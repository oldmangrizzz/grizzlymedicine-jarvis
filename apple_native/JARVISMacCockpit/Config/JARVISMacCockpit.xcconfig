MACOSX_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
SWIFT_VERSION = 6.0
CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_CXX_LIBRARY = libc++
HEADER_SEARCH_PATHS = $(SRCROOT)/../JARVISNativeRuntime $(SRCROOT)/../JARVISNativeRuntime/logging
PRODUCT_BUNDLE_IDENTIFIER = org.gmri.jarvis.cockpit
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/JARVISMacCockpit-Bridging-Header.h
CODE_SIGN_ENTITLEMENTS = $(SRCROOT)/JARVISMacCockpit.entitlements
INFOPLIST_FILE = $(SRCROOT)/Info.plist

// Hardened Runtime + Apple Distribution signing for distribution.
// SIGNING_IDENTITY defaults in tools scripts to Robert Hanson (T5AFHQ4L9C) SHA1 461BE4E2E42E344CD73214DBC38268EBCA757BE2.
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = T5AFHQ4L9C
CODE_SIGN_IDENTITY = Apple Distribution
OTHER_CODE_SIGN_FLAGS = --options runtime --timestamp
ENABLE_HARDENED_RUNTIME = YES
