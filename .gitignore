*.pyc
*.pyo
.pytest_cache/
.venv/

# --- Node / Convex (regenerable; deploy via CONVEX_DEPLOY_KEY) ---
node_modules/
.convex/
convex/_generated/
**/convex/_generated/
package-lock.json

# --- Rust / Tauri build outputs ---
target/
**/target/
.build/
**/.build/
jarvis_app/src-tauri/gen/
jarvis_app/src-tauri/icons/android/
jarvis_app/src-tauri/icons/ios/

# --- Xcode local state ---
DerivedData/
**/DerivedData/
xcuserdata/
**/xcuserdata/
*.xcuserstate

# --- generated / transient audio (regenerable) ---
*.wav
_local_voice/
*.safetensors

